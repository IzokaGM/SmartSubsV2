{
  "name": "smartsubsv2",
  "main": "src/cloudflare-worker.mjs",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_CHUNK_ABORT_RETRY_MS": "1000",
    "GEMINI_MOVIE_HEDGE_ENABLED": "true",
    "GEMINI_MOVIE_HEDGE_DELAY_MS": "35000",
    "QUEUE_MOVIE_TARGET_CHUNKS": "10",
    "QUEUE_MOVIE_CHUNK_ITEMS_MIN": "160",
    "QUEUE_MOVIE_CHUNK_ITEMS_MAX": "200",
    "SMARTSUBS_CACHE_VERSION": "m8-v1",
    "SMARTSUBS_CACHE_TTL_MS": "15552000000",
    "TRANSLATION_CHUNK_ITEMS": "180",
    "TRANSLATION_CHUNK_CHARS": "24000",
    "TRANSLATION_CONCURRENCY": "2",
    "QUEUE_TRANSLATION_CHUNK_ITEMS": "240",
    "QUEUE_TRANSLATION_CHUNK_CHARS": "30000",
    "QUEUE_TRANSLATION_CONCURRENCY": "2",
    "QUEUE_JOIN_MAX_MS": "55000",
    "QUEUE_JOIN_POLL_MS": "1500",
    "PLAYER_QUEUE_POLL_EARLY_MS": "6000",
    "PLAYER_QUEUE_POLL_FAST_START_MS": "12000",
    "PLAYER_QUEUE_POLL_LATE_START_MS": "25000",
    "PLAYER_QUEUE_POLL_LATE_MS": "3000",
    "PLAYER_MOVIE_POLL_STEP_MS": "7000",
    "PLAYER_MOVIE_POLL_FAST_START_MS": "21000",
    "PLAYER_MOVIE_POLL_LATE_MS": "3000",
    "QUEUE_JOB_TTL_SECONDS": "600",
    "QUEUE_PARALLEL_CHUNK_ITEMS": "160",
    "QUEUE_PARALLEL_CHUNK_CHARS": "20000",
    "QUEUE_PARALLEL_CONCURRENCY": "3",
    "QUEUE_FALLBACK_CHUNK_ITEMS": "180",
    "QUEUE_FALLBACK_CHUNK_CHARS": "24000",
    "QUEUE_FALLBACK_CONCURRENCY": "2",
    "QUEUE_FINAL_CHUNK_ITEMS": "160",
    "QUEUE_FINAL_CHUNK_CHARS": "20000",
    "QUEUE_FINAL_CONCURRENCY": "5",
    "QUEUE_USER_SELECTED_CHUNK_ITEMS": "160",
    "QUEUE_USER_SELECTED_CHUNK_CHARS": "20000",
    "QUEUE_USER_SELECTED_CONCURRENCY": "5",
    "PLAYER_QUEUE_WAIT_MAX_MS": "30000",
    "PLAYER_MOVIE_QUEUE_WAIT_MAX_MS": "33000",
    "PLAYER_QUEUE_GRACE_MS": "600",
    "DELIVERY_RELAY_TTL_MS": "120000"
  },
  "kv_namespaces": [
    {
      "binding": "SMARTSUBS_CACHE",
      "id": "dee972fb2e584111a7cd9666cbbd371f"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SMARTSUBS_TRANSLATION_QUEUE",
        "queue": "smartsubsv2-translation"
      }
    ],
    "consumers": [
      {
        "queue": "smartsubsv2-translation",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "retry_delay": 10,
        "max_concurrency": 1
      }
    ]
  },
  "ratelimits": [
    {
      "name": "SMARTSUBS_SUBTITLE_LIMITER",
      "namespace_id": "9282101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SMARTSUBS_GENERATE_LIMITER",
      "namespace_id": "9282102",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SMARTSUBS_DELIVERY",
        "class_name": "TranslationDeliveryRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2-part4-3-delivery-relay",
      "new_sqlite_classes": [
        "TranslationDeliveryRelay"
      ]
    }
  ]
}
